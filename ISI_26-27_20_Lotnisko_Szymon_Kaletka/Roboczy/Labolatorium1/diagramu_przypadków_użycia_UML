@startuml
' Laboratorium 1 – Zintegrowany System Obsługi Lotniska
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome
skinparam linetype ortho
skinparam defaultFontName Arial
skinparam usecase {
  BackgroundColor #F4F7FB
  BorderColor #355070
  ArrowColor #52677D
}
skinparam rectangle {
  BorderColor #355070
}
skinparam package {
  BorderColor #8A9BAE
  FontStyle bold
}

' Aktorzy wewnętrzni
actor "Pasażer" as Passenger
actor "Pracownik odprawy" as Checkin
actor "Pracownik obsługi\nnaziemnej" as Ground
actor "Kontroler ruchu\nlotniczego" as ATC
actor "Pracownik terminala" as Terminal
actor "Pracownik techniczny" as Tech
actor "Pracownik\nbezpieczeństwa" as Security
actor "Pracownik\nadministracji" as Admin
actor "Administrator\nsystemu" as SysAdmin

' Aktorzy zewnętrzni
actor "Zewnętrzny system\npłatności" as Payment
actor "Zewnętrzny system\npowiadomień" as Notification

rectangle "Zintegrowany System Obsługi Lotniska" as System {

  package "Konta i dostęp" {
    usecase "Rejestracja pasażera" as UC01
    usecase "Logowanie i wylogowanie" as UC02
    usecase "Zarządzanie kontami\noraz rolami" as UC03
    usecase "Konfiguracja systemu" as UC04
    usecase "Przeglądanie dziennika zdarzeń" as UC05
  }

  package "Rezerwacje i obsługa pasażera" {
    usecase "Wyszukiwanie lotów\ni przeglądanie szczegółów" as UC06
    usecase "Utworzenie rezerwacji" as UC07
    usecase "Przeglądanie i anulowanie\nrezerwacji" as UC08
    usecase "Wybór miejsca" as UC09
    usecase "Obsługa płatności" as UC10
    usecase "Odprawa online" as UC11
    usecase "Pobranie karty pokładowej" as UC12
    usecase "Zamawianie usług dodatkowych\ni zgłaszanie bagażu" as UC13
    usecase "Złożenie reklamacji" as UC36
    usecase "Przeglądanie powiadomień" as UC37
  }

  package "Odprawa i bagaż" {
    usecase "Wyszukanie rezerwacji" as UC14
    usecase "Weryfikacja danych pasażera" as UC15
    usecase "Odprawa stanowiskowa" as UC16
    usecase "Rejestracja bagażu\ni druk etykiety" as UC17
    usecase "Weryfikacja wejścia na pokład" as UC18
    usecase "Obsługa zagubionego bagażu" as UC19
  }

  package "Operacje lotnicze i terminal" {
    usecase "Przeglądanie harmonogramu lotów" as UC20
    usecase "Zarządzanie danymi i statusem lotu" as UC21
    usecase "Przydzielanie zasobów lotniczych" as UC22
    usecase "Wykrywanie konfliktów operacyjnych" as UC23
    usecase "Zarządzanie bramkami\ni stanowiskami odprawy" as UC24
    usecase "Monitorowanie przepływu pasażerów" as UC25
    usecase "Obsługa samolotu po lądowaniu" as UC26
    usecase "Przygotowanie samolotu do kolejnego lotu" as UC27
    usecase "Rejestrowanie załadunku\ni rozładunku bagażu" as UC28
    usecase "Przeglądanie i realizacja zadań" as UC38
  }

  package "Utrzymanie i bezpieczeństwo" {
    usecase "Obsługa zgłoszeń technicznych" as UC29
    usecase "Przeglądy i ewidencja wyposażenia" as UC30
    usecase "Rejestrowanie i obsługa incydentów" as UC31
  }

  package "Administracja i raportowanie" {
    usecase "Zarządzanie personelem" as UC32
    usecase "Generowanie i eksport raportów" as UC33
    usecase "Analiza finansów i rozliczeń" as UC34
    usecase "Przydzielanie zadań pracownikom" as UC39
    usecase "Obsługa reklamacji" as UC40
  }

  package "Komunikacja" {
    usecase "Przekazanie powiadomienia" as UC35
  }
}

' Pasażer
Passenger -- UC01
Passenger -- UC02
Passenger -- UC06
Passenger -- UC07
Passenger -- UC08
Passenger -- UC09
Passenger -- UC10
Passenger -- UC11
Passenger -- UC12
Passenger -- UC13
Passenger -- UC36
Passenger -- UC37

' Pracownik odprawy
Checkin -- UC02
Checkin -- UC14
Checkin -- UC15
Checkin -- UC16
Checkin -- UC17
Checkin -- UC18
Checkin -- UC19

' Pracownik obsługi naziemnej
Ground -- UC02
Ground -- UC20
Ground -- UC26
Ground -- UC27
Ground -- UC28
Ground -- UC38

' Kontroler ruchu lotniczego
ATC -- UC02
ATC -- UC20
ATC -- UC21
ATC -- UC22
ATC -- UC23

' Pracownik terminala
Terminal -- UC02
Terminal -- UC20
Terminal -- UC24
Terminal -- UC25

' Pracownik techniczny
Tech -- UC02
Tech -- UC29
Tech -- UC30

' Pracownik bezpieczeństwa
Security -- UC02
Security -- UC31

' Pracownik administracji
Admin -- UC02
Admin -- UC32
Admin -- UC33
Admin -- UC34
Admin -- UC39
Admin -- UC40

' Administrator systemu
SysAdmin -- UC02
SysAdmin -- UC03
SysAdmin -- UC04
SysAdmin -- UC05

' Integracje zewnętrzne
Payment -- UC10
Notification -- UC35

' Relacje include – zachowanie obowiązkowe w ramach procesu
UC09 .> UC07 : <<extend>>
UC10 .> UC07 : <<extend>>
UC16 .> UC14 : <<include>>
UC16 .> UC15 : <<include>>
UC17 .> UC16 : <<extend>>
UC22 .> UC23 : <<include>>

' Powiadomienia są uruchamiane zdarzeniowo
UC35 .> UC21 : <<extend>>
UC35 .> UC08 : <<extend>>
UC35 .> UC11 : <<extend>>

note bottom of System
Diagram przedstawia główne funkcje systemu na poziomie Laboratorium 1.
Szczegółowe scenariusze i warunki alternatywne mogą zostać opisane
w dalszej dokumentacji przypadków użycia.
end note

@enduml
