        ' Nowy przypadek użycia
        usecase "Zarządzaj stanowiskami\nodprawy" as UC55
    }

    package "Obsługa naziemna i personel" {

        usecase "Przygotuj samolot do lotu" as UC36
        usecase "Obsłuż samolot po lądowaniu" as UC37
        usecase "Załaduj i rozładuj bagaż" as UC38
        usecase "Zarządzaj personelem" as UC39
        usecase "Przydziel zadania pracownikom" as UC40
        usecase "Zaplanuj sprzątanie" as UC41
