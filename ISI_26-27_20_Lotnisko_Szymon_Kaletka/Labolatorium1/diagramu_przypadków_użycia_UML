    package "Obsługa terminala i bagażu" {

        usecase "Przeprowadź odprawę pasażera" as UC27
        usecase "Nadaj bagaż rejestrowany" as UC28
        usecase "Wydrukuj etykietę bagażową" as UC29
        usecase "Przydziel bramkę" as UC30
        usecase "Zarządzaj bramkami" as UC31
        usecase "Kontroluj boarding" as UC32
        usecase "Zarządzaj przepływem pasażerów" as UC33
        usecase "Monitoruj transport bagażu" as UC34
