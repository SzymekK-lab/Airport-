
@startuml
left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome

skinparam usecase {
    BackgroundColor #EAF2F8
    BorderColor #2874A6
    ArrowColor #34495E
}

skinparam rectangle {
    BorderColor #34495E
}

title Diagram przypadków użycia - System obsługi lotniska

' =========================
' AKTORZY
' =========================

actor "Pasażer" as Passenger
actor "Pracownik odprawy" as Checkin
actor "Pracownik obsługi\nnaziemnej" as Ground
actor "Kontroler ruchu\nlotniczego" as ATC
actor "Pracownik terminala" as Terminal
actor "Pracownik techniczny" as Technician
actor "Pracownik bezpieczeństwa\ni ratownictwa" as Security
actor "Pracownik administracji" as Office
actor "Administrator systemu" as Admin

actor "System płatności" as Payment
actor "System powiadomień" as Notification

' =========================
' SYSTEM LOTNISKA
' =========================

rectangle "ZINTEGROWANY SYSTEM OBSŁUGI LOTNISKA" {

    package "Portal pasażera i rezerwacje" {

        usecase "Utwórz konto" as UC1
        usecase "Zaloguj się" as UC2
        usecase "Wyszukaj lot" as UC3
        usecase "Sprawdź status lotu" as UC4
        usecase "Zarezerwuj bilet" as UC5
        usecase "Kup bilet" as UC6
        usecase "Opłać rezerwację" as UC7
        usecase "Zarządzaj rezerwacją" as UC8
        usecase "Anuluj rezerwację" as UC9
        usecase "Wykonaj odprawę online" as UC10
        usecase "Wybierz miejsce w samolocie" as UC11
        usecase "Wygeneruj kartę pokładową" as UC12
