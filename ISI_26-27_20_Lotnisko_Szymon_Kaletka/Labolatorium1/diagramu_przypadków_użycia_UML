        usecase "Przeglądaj dziennik zdarzeń" as UC53
        usecase "Wysyłaj powiadomienia" as UC54

        ' Nowe funkcje wspólne dla użytkowników systemu
        usecase "Wyloguj się" as UC56
        usecase "Zarządzaj własnym kontem" as UC57
    }
}

