        usecase "Przeprowadź przegląd techniczny" as UC43
        usecase "Zarządzaj wyposażeniem" as UC44
    }

    package "Bezpieczeństwo i administracja" {

        usecase "Monitoruj bezpieczeństwo lotniska" as UC45
        usecase "Obsłuż sytuację awaryjną" as UC46
        usecase "Zarejestruj incydent" as UC47
        usecase "Zarządzaj użytkownikami" as UC48
        usecase "Zarządzaj rolami i uprawnieniami" as UC49
